{
  "name": "tc-log",
  "version": "1.0.0",
  "description": "workflows for transfer centers",
  "keywords": [
    "google",
    "google-apps-script",
    "javascript",
    "clasp"
  ],
  "homepage": "https://github.com/kennethdait/tc-log#readme",
  "bugs": {
    "url": "https://github.com/kennethdait/tc-log/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kennethdait/tc-log.git"
  },
  "license": "MIT",
  "author": "Ken Dait",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "who": "npx clasp show-authorized-user",
    "list-projects": "npx clasp list-scripts --noShorten | sed '1d' | awk -F' - ' '{print $1}' | sort -d",
    "push": "npx clasp push --force",
    "watch": "npx clasp push --force --watch"
  },
  "devDependencies": {
    "@google/clasp": "^3.1.0",
    "@types/google-apps-script": "^2.0.6"
  }
}